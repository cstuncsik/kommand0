#!/usr/bin/env bash
# Fake INTERACTIVE claude for embedded-pane e2e tests: enters the alternate
# screen, prints a recognizable banner + prompt, then echoes typed input.
stty -echo 2>/dev/null              # raw-ish like a real TUI: we echo, not the tty
printf '\033[?1049h\033[2J\033[H'   # alt-screen + clear
printf '\033[?1000h\033[?1006h'     # enable SGR mouse reporting (like real claude)
printf 'ARGS:[%s]\r\n' "$*"         # echo spawn args so e2e can assert --session-id/--resume
printf 'EMBED-STUB-READY\r\n> '
while IFS= read -r -n1 ch; do
  # Echo each received byte; render ESC as a visible '^' so forwarded escape
  # sequences (e.g. mouse reports) show up as plain text in the e2e screen.
  if [ "$ch" = $'\033' ]; then printf '^'; else printf '%s' "$ch"; fi
done
