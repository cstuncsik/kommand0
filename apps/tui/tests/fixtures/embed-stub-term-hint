#!/usr/bin/env bash
# Fake opencode for the quit-capture e2e: stays alive until SIGTERM, then
# leaves the alt screen and prints the exit summary line (with the resumable
# session id) the real opencode prints on a graceful terminate, and exits 0.
# The trap also kills the background sleep: it inherited the PTY slave, and
# kommand0's teardown capture scans the grid only after reader EOF, which
# needs every slave fd closed (real opencode is a single process).
stty -echo 2>/dev/null
printf '\033[?1049h\033[2J\033[H'   # alt-screen + clear
trap 'printf "\033[?1049l\r\nopencode -s ses_e2eQuitCapture42\r\n"; kill $! 2>/dev/null; exit 0' TERM
printf 'ARGS:[%s]\r\n' "$*"
printf 'TERM-STUB-READY\r\n'
sleep 60 & wait $!
